  Widget _buildServiceStatus(bool isSelected) {
    return Column(children: [
      Container(
          width: 70,
          height: 70,
          decoration: BoxDecoration(
              shape: BoxShape.circle,
              color:
                  (isSelected ? successColor : warningColor).withOpacity(0.1)),
          child: Icon(
              isSelected ? Iconsax.calendar_tick : Iconsax.calendar_remove,
              color: isSelected ? successColor : warningColor,
              size: 35)),
      const SizedBox(height: 8),
      Text(isSelected ? 'On Service' : 'Not on Duty',
          style: GoogleFonts.poppins(color: kSubtleTextColor)),
    ]);
  }
