              mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
              children: [
                pw.Text(AmharicStringsPdf.documentTitle, // Translated
                    style: pw.TextStyle(
                        font: notoTtfBold,
                        fontSize: 24,
                        fontWeight: pw.FontWeight.bold)),
                pw.Image(logoImage, width: 60, height: 60),
              ],
            ),
            pw.Divider(thickness: 2),
