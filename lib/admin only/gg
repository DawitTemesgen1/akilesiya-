                  const SizedBox(height: 8),

                  // Author and Date (Translated and responsive font)
                  Text(
                    "${AmharicStringsVideoPlayer.by} ${widget.content.author} • ${DateFormat.yMMMd().format(widget.content.publishDate)}",
