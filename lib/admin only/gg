                              width: 112,
                              height: 112,
                              color: primaryColor.withOpacity(0.2),
                              child: const Icon(Iconsax.user,
                                  size: 50, color: accentColor),
                            ),
                            errorWidget: (context, url, error) => const Icon(
                              Iconsax.user,
                              size: 50,
                              color: accentColor,
