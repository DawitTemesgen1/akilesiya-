                  child: Text("ፈቃዶችን ለማስተዳደር ተጠቃሚ ይምረጡ",
                      style: GoogleFonts.notoSansEthiopic(
                          color: kAdminPrimaryAccent)))
              : _isDetailLoading
                  ? const Center(child: CircularProgressIndicator())
