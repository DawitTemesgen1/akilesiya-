class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();

  static Route<dynamic> route() {
    return MaterialPageRoute<dynamic>(
      builder: (_) => const HomeScreen(),
    );
  }
}

class _HomeScreenState extends State<HomeScreen> {
  int _selectedIndex = 0;
  late final PageController _pageController;

  @override
  void initState() {
    super.initState();
    _pageController = PageController(initialPage: _selectedIndex);
  }

  @override
  void dispose() {
    _pageController.dispose();
    super.dispose();
  }

  void _onItemTapped(int index) {
    setState(() {
      _selectedIndex = index;
      _pageController.jumpToPage(index);
    });
  }

  @override
  Widget build(BuildContext context) {
    final userProvider = context.watch<UserProvider>();
    final languageProvider = context.watch<LanguageProvider>();
    final userId = userProvider.user?.id ?? 'anonymous';
    final l10n = AppLocalizations.of(context)!;

    // Get localized page titles
    List<String> _getPageTitles() {
      return [
        l10n.homePageTitle,
        l10n.managementPageTitle,
        l10n.learningPageTitle,
        l10n.profilePageTitle,
      ];
    }

    final pageTitles = _getPageTitles();

    // Define pages with unique Hero tags
    final List<Widget> pages = [
      _buildPageWithHero(
        userId: userId,
        pageId: 'home',
        child: const HomePage(),
      ),
      _buildPageWithHero(
        userId: userId,
        pageId: 'private',
        child: PrivateHomePage(
            tenantId: userProvider.tenantId ?? 'default-tenant'),
      ),
      _buildPageWithHero(
        userId: userId,
        pageId: 'learning',
        child: const LearningScreen(),
      ),
      _buildPageWithHero(
        userId: userId,
        pageId: 'profile',
        child: const ProfileScreen(),
      ),
    ];

    final int displayedIndex = _selectedIndex.clamp(0, pages.length - 1);
    final String currentTitle =
        displayedIndex < pageTitles.length ? pageTitles[displayedIndex] : '';

    return LayoutBuilder(
      builder: (context, constraints) {
        final isWideScreen = constraints.maxWidth > 600;

        return Scaffold(
          appBar: AppBar(
            title: Hero(
              tag: HeroTags.appBarProfile(userId),
              child: Material(
                type: MaterialType.transparency,
                child: Text(
                  currentTitle,
                  style: const TextStyle(
                    fontFamily: 'NotoSansEthiopic',
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
            ),
            actions: [
              IconButton(
                icon: const Icon(Icons.language),
                onPressed: () {
                  // Toggle between English and Amharic
                  final newLocale =
                      languageProvider.currentLocale.languageCode == 'en'
                          ? const Locale('am')
                          : const Locale('en');
                  languageProvider.setLocale(newLocale);
                },
              ),
            ],
          ),
          body: Row(
            children: [
              if (isWideScreen)
                Hero(
                  tag: HeroTags.navRail(userId),
                  child: Material(
                    child: _buildNavigationRail(
                        userId, languageProvider.currentLocale),
                  ),
                ),
              Expanded(
                child: PageView.builder(
                  controller: _pageController,
                  physics: const NeverScrollableScrollPhysics(),
                  itemCount: pages.length,
                  itemBuilder: (context, index) => pages[index],
                  onPageChanged: (index) {
                    setState(() {
                      _selectedIndex = index;
                    });
                  },
                ),
              ),
            ],
          ),
          bottomNavigationBar: !isWideScreen
              ? Hero(
                  tag: HeroTags.bottomNav(userId),
                  child: Material(
                    child: _buildBottomNavBar(
                        userId, languageProvider.currentLocale),
                  ),
                )
              : null,
        );
      },
    );
  }

  Widget _buildPageWithHero({
    required String userId,
    required String pageId,
    required Widget child,
  }) {
    return Hero(
      tag: HeroTags.mainContent(userId, pageId),
      child: Material(
        type: MaterialType.transparency,
        child: child,
      ),
    );
  }

  Widget _buildNavigationRail(String userId, Locale currentLocale) {
    final l10n = AppLocalizations.of(context)!;

    return NavigationRail(
      selectedIndex: _selectedIndex,
      onDestinationSelected: _onItemTapped,
      labelType: NavigationRailLabelType.all,
      leading: Column(
        children: [
          const SizedBox(height: 8),
          CircleAvatar(
            radius: 20,
            backgroundColor: AppColors.primaryColor,
            child: Text(
              '${userId.isNotEmpty ? userId[0].toUpperCase() : 'U'}',
              style: const TextStyle(color: Colors.white),
            ),
          ),
          const SizedBox(height: 16),
        ],
      ),
      destinations: [
        NavigationRailDestination(
          icon: const Icon(Icons.home_outlined),
          selectedIcon: const Icon(Icons.home),
          label: Text(
            l10n.homePageTitle,
            style: TextStyle(
              fontFamily: currentLocale.languageCode == 'am'
                  ? 'NotoSansEthiopic'
                  : 'Roboto',
            ),
          ),
        ),
        NavigationRailDestination(
          icon: const Icon(Icons.lock_outline),
          selectedIcon: const Icon(Icons.lock),
          label: Text(
            l10n.managementPageTitle,
            style: TextStyle(
              fontFamily: currentLocale.languageCode == 'am'
                  ? 'NotoSansEthiopic'
                  : 'Roboto',
            ),
          ),
        ),
        NavigationRailDestination(
          icon: const Icon(Icons.school_outlined),
          selectedIcon: const Icon(Icons.school),
          label: Text(
            l10n.learningPageTitle,
            style: TextStyle(
              fontFamily: currentLocale.languageCode == 'am'
                  ? 'NotoSansEthiopic'
                  : 'Roboto',
            ),
          ),
        ),
        NavigationRailDestination(
          icon: const Icon(Icons.person_outline),
          selectedIcon: const Icon(Icons.person),
          label: Text(
            l10n.profilePageTitle,
            style: TextStyle(
              fontFamily: currentLocale.languageCode == 'am'
                  ? 'NotoSansEthiopic'
                  : 'Roboto',
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildBottomNavBar(String userId, Locale currentLocale) {
    final l10n = AppLocalizations.of(context)!;

    return BottomNavigationBar(
      currentIndex: _selectedIndex,
      onTap: _onItemTapped,
      type: BottomNavigationBarType.fixed,
      selectedItemColor: AppColors.primaryColor,
      unselectedItemColor: Colors.grey[600],
      selectedLabelStyle: TextStyle(
        fontSize: 12,
        fontFamily:
            currentLocale.languageCode == 'am' ? 'NotoSansEthiopic' : 'Roboto',
      ),
      unselectedLabelStyle: TextStyle(
        fontSize: 11,
        fontFamily:
            currentLocale.languageCode == 'am' ? 'NotoSansEthiopic' : 'Roboto',
      ),
      items: [
        BottomNavigationBarItem(
          icon: Icon(
            _selectedIndex == 0 ? Icons.home : Icons.home_outlined,
          ),
          label: l10n.homePageTitle,
        ),
        BottomNavigationBarItem(
          icon: Icon(
            _selectedIndex == 1 ? Icons.lock : Icons.lock_outline,
          ),
          label: l10n.managementPageTitle,
        ),
        BottomNavigationBarItem(
          icon: Icon(
            _selectedIndex == 2 ? Icons.school : Icons.school_outlined,
          ),
          label: l10n.learningPageTitle,
        ),
        BottomNavigationBarItem(
          icon: Icon(
            _selectedIndex == 3 ? Icons.person : Icons.person_outline,
          ),
          label: l10n.profilePageTitle,
        ),
      ],
    );
  }
}

