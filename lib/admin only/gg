        trailing: Text(
          (value?.toString().isNotEmpty ?? false)
              ? value.toString()
              : 'አልተገለጸም',
          style: GoogleFonts.notoSansEthiopic(color: accentColor, fontSize: 16),
          textAlign: TextAlign.right,
        ),
      );
}

