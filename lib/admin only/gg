                  Text(
                    widget.link == null ? 'አዲስ ሊንክ ጨምር' : 'ሊንክ አርትዕ',
                    style: GoogleFonts.notoSansEthiopic(
                        fontSize: 22,
                        fontWeight: FontWeight.bold,
                        color: primaryColor),
                  ),
