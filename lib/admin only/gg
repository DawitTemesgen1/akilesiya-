  void initState() {
    super.initState();
    _selectedFields = {};
    _sectionKeys.forEach((_, keys) {
      for (var key in keys) {
        if (widget.profileConfig.isWidgetVisible(key)) {
          _selectedFields.add(key);
        }
      }
    });
    for (var field in widget.profileConfig.customFields) {
      _selectedFields.add('custom_${field['id']}');
    }
  }

