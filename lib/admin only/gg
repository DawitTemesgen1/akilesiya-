String _formatDate(DateTime date) {
  final now = DateTime.now();
  final difference = now.difference(date);
  if (difference.inHours < 1) return AmhDateTag_JustNow; // Translated
  if (difference.inHours < 24)
    return '${difference.inHours} ${AmhDateTag_HoursAgoSuffix}'; // Translated
  if (difference.inDays == 1) return AmhDateTag_Yesterday; // Translated
  final format = DateFormat.yMMMd();
  return format.format(date);
}

String _formatDateTime(DateTime date) {
  final format = DateFormat.yMMMd().add_jm();
  return format.format(date);
}
