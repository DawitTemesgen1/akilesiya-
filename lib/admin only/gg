    final customFields = widget.profileConfig.customFields;
    if (customFields.isEmpty) return const SizedBox.shrink();
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Padding(
          padding: EdgeInsets.only(top: 16.0, bottom: 8.0, left: 16),
          child: Text('ተጨማሪ መረጃ',
