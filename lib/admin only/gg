                  ),
                  const SizedBox(height: 32),
                  Text(
                    AppLocalizations.of(context)?.sysAdminQuickActions ?? 'Quick Actions',
                    style: GoogleFonts.notoSansEthiopic(
                      fontSize: 22,
                      fontWeight: FontWeight.bold,
