              ElevatedButton.icon(
                  icon: const Icon(Iconsax.refresh),
                  label: const Text("እንደገና ሞክር"),
                  onPressed: _loadData)
            ],
          ),
        ),
      );
    }
    return CustomScrollView(
      slivers: [
        SliverAppBar(
          backgroundColor: AppTheme.primary,
          foregroundColor: AppTheme.textLight,
          pinned: true,
          floating: true,
          expandedHeight: 120,
