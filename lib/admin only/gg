  Map<String, bool> _visibilitySettings = {};

  @override
  void initState() {
    super.initState();
    _loadSettings();
  }

  Future<void> _loadSettings() async {
    setState(() => _isLoading = true);
    final result = await UserAdminService.getProfileSettings();
