            _buildInfoRow('Verified', user?['is_verified'] == 1 ? 'Yes' : 'No'),
            _buildInfoRow(
                'Last Login',
                user?['last_login'] != null
                    ? _formatDate(user?['last_login'])
                    : 'Never'),
            _buildInfoRow('Member Since', _formatDate(user?['created_at'])),
          ],
        ),
      ),
    );
  }

