            style: GoogleFonts.poppins(
                fontWeight: FontWeight.bold,
                fontSize: 16,
                color: _getGradeColor(grade))),
      ]),
      const SizedBox(height: 8),
      LinearPercentIndicator(
          percent: grade / 100,
          lineHeight: 10,
          barRadius: const Radius.circular(5),
          progressColor: _getGradeColor(grade),
